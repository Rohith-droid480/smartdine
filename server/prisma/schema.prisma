// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  customer
  staff
  admin
}

enum TableStatus {
  free
  reserved
  occupied
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
  completed
}

enum OrderStatus {
  placed
  preparing
  ready
  served
  billed
}

enum NotificationChannel {
  in_app
  email
}

// =============================================================================
// Models
// =============================================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         UserRole @default(customer)
  isVerified   Boolean  @default(false)
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  otpCodes      OtpCode[]
  reservations  Reservation[]
  orders        Order[]
  notifications Notification[]
  staffProfile  Staff?
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@map("otp_codes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  category    String
  available   Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  orderItems OrderItem[]

  @@index([category])
  @@index([available])
  @@map("menu_items")
}

model Table {
  id        String      @id @default(uuid())
  number    Int         @unique
  capacity  Int
  status    TableStatus @default(free)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  reservations Reservation[]
  orders       Order[]

  @@index([status])
  @@map("tables")
}

model Reservation {
  id        String            @id @default(uuid())
  userId    String
  tableId   String
  time      DateTime
  partySize Int
  status    ReservationStatus @default(pending)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  table Table @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([tableId])
  @@index([status])
  @@index([time])
  @@map("reservations")
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  tableId   String?
  status    OrderStatus @default(placed)
  total     Decimal     @db.Decimal(10, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  table Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([tableId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  menuItemId   String
  quantity     Int
  priceAtOrder Decimal @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model InventoryItem {
  id               String   @id @default(uuid())
  name             String
  quantity         Decimal  @db.Decimal(10, 3)
  unit             String
  reorderThreshold Decimal  @db.Decimal(10, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([name])
  @@map("inventory_items")
}

model Staff {
  id        String   @id @default(uuid())
  userId    String   @unique
  role      String
  shift     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
  @@map("staff")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  message   String
  read      Boolean             @default(false)
  channel   NotificationChannel @default(in_app)
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}
