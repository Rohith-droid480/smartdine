{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@smartdine/shared": ["../shared"],
      "@smartdine/shared/*": ["../shared/*"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    // Override: exactOptionalPropertyTypes conflicts with @types/jsonwebtoken's SignOptions.
    // The base tsconfig enables this for shared/ (pure types), but Express + JWT libs
    // use optional properties in ways incompatible with this flag.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "prisma"]
}


