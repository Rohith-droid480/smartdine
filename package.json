{
  "name": "smartdine",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "dev:server": "turbo run dev --filter=server",
    "dev:web": "turbo run dev --filter=customer-web",
    "dev:admin": "turbo run dev --filter=staff-dashboard",
    "db:generate": "turbo run db:generate --filter=server",
    "db:migrate": "turbo run db:migrate --filter=server",
    "db:studio": "turbo run db:studio --filter=server",
    "db:seed": "turbo run db:seed --filter=server",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2"
}
